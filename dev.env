DOCKER_REGISTRY ?= registry.test.pensando.io:5000
INSECURE_REGISTRY ?= $(DOCKER_REGISTRY)
DOCKER_BUILDER_TAG ?= v1.16
BUILD_BASE_IMAGE ?= $(DOCKER_REGISTRY)/ubuntu:22.04
RHEL_BASE_MIN_IMAGE ?= $(DOCKER_REGISTRY)/ubi9/ubi-minimal:9.8
TESTRUNNER_RHEL_BASE_IMAGE ?= $(DOCKER_REGISTRY)/ubi9/ubi:9.8
EXPORTER_SRIOV_BASE_IMAGE ?= $(DOCKER_REGISTRY)/ubi9/ubi-minimal:9.8
AZURE_BASE_IMAGE ?= $(DOCKER_REGISTRY)/azurelinux/coreos:3.0
AMDSMI_BASE_IMAGE ?= $(DOCKER_REGISTRY)/ubi9/ubi:9.4
AMDSMI_BASE_UBUNTU22 ?= $(BUILD_BASE_IMAGE)
AMDSMI_BASE_UBUNTU24 ?= $(DOCKER_REGISTRY)/ubuntu:24.04
AMDSMI_BASE_AZURE ?= $(AZURE_BASE_IMAGE)
GPUAGENT_BASE_IMAGE ?= $(BUILD_BASE_IMAGE)
ROCPROFILER_BASE_UBUNTU22 ?= $(DOCKER_REGISTRY)/ubuntu:22.04

# base image for the gpuagent builder container; full ubi9 (has dnf/yum) and
# glibc matched to the ubi9 exporter runtime so gpuagent links against the same libc
GPUAGENT_BUILDER_BASE_IMAGE ?= $(DOCKER_REGISTRY)/ubi9/ubi:9.8

# ROCM_VERSION / ROCM_TARBALL_URL: authoritative defaults in Makefile.
RVS_TARBALL_URL ?= https://repo.amd.com/rocm/rvs/tarball/amdrocm7-rvs-1.5.122-579-Linux.tar.gz

# AGFHC test-runner ROCm pin. The AGFHC bundle (agfhc-mi300_<ver>) ships rocm7
# packages and its installer aborts ("rocm folder not found") when pointed at
# ROCm 10.0. The test-runner is not part of the ROCm-10 runtime; keep its AGFHC
# build on the last-known-good rocm7 tarball until an AGFHC build supports 10.0.
AGFHC_ROCM_VERSION ?= 7.14.0
AGFHC_ROCM_TARBALL_URL ?= https://repo.amd.com/rocm/tarball-multi-arch/therock-dist-linux-multiarch-7.14.0.tar.gz

# Two-knob source model for the DME build targets.
#
# AMDSMI_FROM_TARBALL:
#   1 = re-extract amdsmi.h + libamd_smi.so + sysdeps from the therock tarball at
#       build time (default: standard path on main for non-SR-IOV targets).
#   0 = escape hatch: use the pre-staged amdsmi (26.5.0) + rocm_sysdeps libs from
#       assets/.
# SR-IOV keeps gim_smi_lib on its assets/gimsmi-compile path (the tarball does not
# ship the GIM SMI lib), so this knob does not affect the SR-IOV amdsmi source.
AMDSMI_FROM_TARBALL ?= 1

# GPUAGENT_FROM_SOURCE:
#   1 = build gpuagent/gpuctl/gpuagent_mock/gpuagent_gim once from source via the
#       shared producer target (build/gpuagent/.stamp) and consume those binaries
#       (default: standard path on main for all gpuagent-dependent targets).
#   0 = escape hatch: consume the committed assets/gpuagent_*.bin.gz prebuilt blobs.
GPUAGENT_FROM_SOURCE ?= 1
