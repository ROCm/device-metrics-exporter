+/// default of amdsmi's gpu metrics cache, verified in the shipped
+/// libamd_smi.so 27.1.0+4c2f7505: AMDSMI_GPU_METRICS_CACHE_MS is read with
+/// getenv() once, at library static init, with a 1 ms default
+#define AGA_AMDSMI_GPU_METRICS_CACHE_DFLT_MS    1
+
+/// \brief    effective amdsmi gpu metrics cache duration, in ms
+/// NOTE:
+/// mirrors amdsmi's own parsing (max(0, stoi(env)), the default if no number
+/// parses); the library read the same process environment at load, so an
+/// operator override is honoured
+static uint32_t
+smi_gpu_metrics_cache_ms_ (void)
+{
+    long val;
+    char *end;
+    const char *env = std::getenv("AMDSMI_GPU_METRICS_CACHE_MS");
+
+    if ((env == nullptr) || (*env == '\0')) {
+        return AGA_AMDSMI_GPU_METRICS_CACHE_DFLT_MS;
+    }
+    val = strtol(env, &end, 10);
+    if (end == env) {
+        return AGA_AMDSMI_GPU_METRICS_CACHE_DFLT_MS;
+    }
+    if (val < 0) {
+        return 0;
+    }
+    return (val > (long)UINT32_MAX) ? UINT32_MAX : (uint32_t)val;
+}
+
+sdk_ret_t
+smi_watch_period_check (uint32_t fast_ms)
+{
+    uint32_t cache_ms;
+
+    if ((fast_ms == 0) || (fast_ms >= AGA_GPU_WATCH_FAST_TIER_MIN_MS)) {
+        return SDK_RET_OK;
+    }
+    // a gpu metrics cache longer than the period would repeat stale values
+    cache_ms = smi_gpu_metrics_cache_ms_();
+    if (cache_ms > fast_ms) {
+        AGA_TRACE_ERR("GPU watch fast period {} ms is shorter than "
+                      "AMDSMI_GPU_METRICS_CACHE_MS {} ms", fast_ms, cache_ms);
+        return SDK_RET_INVALID_ARG;
+    }
+    // sub-second periods need the power sampler thread, not started yet
+    AGA_TRACE_ERR("GPU watch fast period {} ms not supported, power sampler "
+                  "not started", fast_ms);
+    return SDK_RET_OP_NOT_SUPPORTED;
+}
+
 }    // namespace aga
