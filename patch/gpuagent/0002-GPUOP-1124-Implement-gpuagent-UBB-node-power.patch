+++ b/sw/nic/gpuagent/api/internal/aga_gpu_watch.hpp
@@ -284,6 +284,8 @@ typedef struct aga_gpu_watch_fields_s {
     /// PCIe link speed (in GT/s) from amdsmi_get_pcie_info
     uint64_t pcie_speed;
     uint64_t pcie_max_speed;
+    /// UBB node power (W) from amdsmi_get_power_info; partition 0 only
+    uint64_t ubb_power;
 } aga_gpu_watch_fields_t;
 
 /// \brief    reset the fast-tier fields of a watch record to the NA sentinel
@@ -316,6 +318,10 @@ aga_gpu_watch_reset_fast_fields (aga_gpu_watch_fields_t *wi)
     wi->pcie_replay_rollover_count = UINT64_MAX;
     wi->pcie_nack_sent_count = UINT64_MAX;
     wi->pcie_nack_received_count = UINT64_MAX;
+    // UBB node power (own amdsmi_get_power_info read, 1 s supported cadence
+    // floor); GPUOP-1122 must carry it forward on sub-second ticks instead of
+    // resetting it here
+    wi->ubb_power = UINT64_MAX;
     // array-valued fast attrs: empty until (re)populated this tick
