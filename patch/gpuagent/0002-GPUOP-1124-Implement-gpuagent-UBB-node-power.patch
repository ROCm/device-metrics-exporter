     wi->vcn_activity_count = 0;
diff --git a/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc b/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
index 12e5971b442..84aeb1921d0 100644
--- a/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
+++ b/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
@@ -58,6 +58,9 @@ std::unordered_map<aga_gpu_handle_t, amdsmi_gpu_metrics_t> g_gpu_metrics;
 #define AMDSMI_ASIC_IS_RDNA(gfx_ver)    (((gfx_ver) >> 12) == 1)
 /// RDNA GPU handles, recorded at init; read-only during serving so no lock needed
 std::unordered_set<aga_gpu_handle_t> g_rdna_gpus;
+/// partition 0 GPU handles with a valid UBB node power reading, recorded at
+/// create; read-only during serving so no lock needed
+std::unordered_set<aga_gpu_handle_t> g_ubb_power_gpus;
 /// counter resolution in uJ; this is a constant value that we get once during
 /// init time and use whenever we want to calculate energy accumalated
 float g_energy_counter_resolution;
@@ -260,6 +263,36 @@ smi_gpu_init_config_ (aga_gpu_handle_t gpu_handle, aga_gpu_spec_t *spec,
     }
 }
 
+/// \brief    decide UBB node power support once at create time; only partition
+///           0 (or a non-partitioned GPU) is probed since UBB power is node
+///           wide; amdsmi_get_power_info reads sysfs only (no render node)
+/// \param[in] gpu_handle    GPU handle
+/// \param[in] status        GPU status (partition id)
+static void
+smi_gpu_init_ubb_power_ (aga_gpu_handle_t gpu_handle,
+                         const aga_gpu_status_t *status)
+{
+    amdsmi_status_t amdsmi_ret;
+    amdsmi_power_info_t power_info = {};
+
+    // UBB power is node wide; only the primary partition reports it
+    if ((status->partition_id != 0) &&
+        (status->partition_id != AGA_GPU_INVALID_PARTITION_ID)) {
+        return;
+    }
+    // probe once; never amdsmi_get_node_handle/npm_info (render node waker,
+    // ROCM-26020). The return code is not gated on: it carries the
+    // gpu_metrics status (can be BUSY) while ubb_power is still filled
+    power_info.ubb_power = UINT32_MAX;
+    amdsmi_ret = amdsmi_get_power_info(gpu_handle, &power_info);
+    if ((power_info.ubb_power != UINT32_MAX) && (power_info.ubb_power != 0)) {
+        g_ubb_power_gpus.insert(gpu_handle);
+    }
+    AGA_TRACE_INFO("GPU {} UBB power {}supported (probe {}W, ret {})",
+                   gpu_handle, g_ubb_power_gpus.count(gpu_handle) ? "" : "not ",
+                   power_info.ubb_power, amdsmi_ret);
+}
+
 /// \brief     function to get name for amdsmi firmware block enum
 /// \param[in] block    amdsmi firmware block enum
 /// \return    firmware block name
@@ -1347,6 +1380,7 @@ smi_gpu_fill_stats (aga_gpu_handle_t gpu_handle,
                     const aga_gpu_get_filter_t *filter)
 {
     amdsmi_status_t amdsmi_ret;
+    amdsmi_power_info_t power_info = {};
     uint64_t sent, received, max_pkt_size;
     amdsmi_gpu_metrics_t metrics_info = {};
     amdsmi_gpu_metrics_t cached_metrics = {};
@@ -1587,6 +1621,14 @@ smi_gpu_fill_stats (aga_gpu_handle_t gpu_handle,
                 AGA_WIDEN_UINT16_NA(cached_metrics.average_umc_activity, UINT32_MAX);
         }
     }
+    // UBB node power: only on partition 0 handles probed at create time;
+    // never amdsmi_get_node_handle/npm_info (render node waker, ROCM-26020)
+    if (g_ubb_power_gpus.count(gpu_handle)) {
+        power_info.ubb_power = UINT32_MAX;
+        amdsmi_get_power_info(gpu_handle, &power_info);
+        stats->ubb_power = (power_info.ubb_power == 0) ? UINT64_MAX :
+            AGA_WIDEN_UINT32_NA(power_info.ubb_power, UINT64_MAX);
+    }
     return SDK_RET_OK;
 }
 
@@ -2390,6 +2432,8 @@ smi_gpu_init_attrs (aga_gpu_handle_t gpu_handle, const aga_obj_key_t *gpu_key,
     smi_gpu_fill_spec(gpu_handle, gpu_key, spec);
     // read the config attributes
     smi_gpu_init_config_(gpu_handle, spec, status);
+    // decide UBB node power support once
+    smi_gpu_init_ubb_power_(gpu_handle, status);
     return SDK_RET_OK;
 }
 
