diff --git a/sw/nic/gpuagent/api/gpu.cc b/sw/nic/gpuagent/api/gpu.cc
index 8548a6cadbe..37b0cf6505d 100644
--- a/sw/nic/gpuagent/api/gpu.cc
+++ b/sw/nic/gpuagent/api/gpu.cc
@@ -152,6 +152,8 @@ gpu_entry::update_handler(api_params_base *api_params) {
 void
 gpu_entry::fill_stats_(aga_gpu_stats_t *stats,
                        const aga_gpu_get_filter_t *filter) {
+    // UBB node power is NA unless the backend fills it (partition 0, MI350X+)
+    stats->ubb_power = UINT64_MAX;
     // fill stats only for non-parent GPUs
     if (child_gpus_.size()) {
         return;
@@ -321,6 +323,9 @@ gpu_entry::fill_gpu_watch_stats(aga_gpu_watch_attrs_t *stats) {
         case AGA_GPU_WATCH_ATTR_ID_ENERGY_CONSUMED:
             attr_val->long_val = stats_.energy_consumed;
             break;
+        case AGA_GPU_WATCH_ATTR_ID_UBB_POWER:
