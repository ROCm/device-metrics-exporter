 extern "C" {
 #include "nic/third-party/rocm/amd_smi_lib/include/amd_smi/amdsmi.h"
 }
@@ -74,6 +75,8 @@ namespace aga {
 /// energy counter resolution (uJ/count), defined in smi_api.cc (namespace aga);
 /// the watcher reuses it to scale energy_accumulator like GPUGet
 extern float g_energy_counter_resolution;
+/// partition 0 GPU handles with UBB node power, probed at create in smi_api.cc
+extern std::unordered_set<aga_gpu_handle_t> g_ubb_power_gpus;
 
 /// global singleton smi state class instance
 smi_state g_smi_state;
@@ -1262,6 +1265,20 @@ smi_state::smi_watcher_update_all_watch_fields_(uint32_t gpu_id,
                 }
             }
             break;
+        case AGA_GPU_WATCH_ATTR_ID_UBB_POWER:
+            // node wide; read only on partition 0 handles probed at create;
+            // never amdsmi_get_node_handle/npm_info (render node waker,
+            // ROCM-26020). 1 s supported cadence floor: GPUOP-1122 gates this
+            // read to at most once per 1 s on sub-second ticks
+            if (g_ubb_power_gpus.count(gpu_handle)) {
+                power_info.ubb_power = UINT32_MAX;
+                amdsmi_get_power_info(gpu_handle, &power_info);
+                if (power_info.ubb_power != 0) {
+                    watch_db->watch_info[gpu_id].ubb_power =
+                        AGA_WIDEN_UINT32_NA(power_info.ubb_power, UINT64_MAX);
+                }
+            }
+            break;
         default:
             break;
         }
