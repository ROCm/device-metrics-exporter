+    if (!g_watch_field_list.empty()) {
+        return;
+    }
+    for (auto attr_id : k_fast_attrs) {
+        g_watch_field_list.push_back({attr_id, GPU_WATCH_TIER_FAST});
+    }
+    for (auto attr_id : k_slow_attrs) {
+        g_watch_field_list.push_back({attr_id, GPU_WATCH_TIER_SLOW});
+    }
