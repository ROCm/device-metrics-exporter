+    try {
+        q = std::make_shared<gpu_watch_sub_queue_t>();
+        q->slots = new uint8_t[(size_t)slot_size *
+                               AGA_GPU_WATCH_SUB_QUEUE_DEPTH];
+    } catch (const std::bad_alloc&) {
+        return nullptr;
+    }
+    q->max_gpu = max_gpu;
+    q->slot_size = slot_size;
+    return q;
+}
