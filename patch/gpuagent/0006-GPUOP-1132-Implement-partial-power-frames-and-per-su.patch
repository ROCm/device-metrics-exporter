+sdk_ret_t
+smi_watch_sub_attach (aga_gpu_watch_client_ctxt_t *ctxt, uint32_t max_gpu)
+{
+    if (ctxt->queue) {
+        return SDK_RET_OK;
+    }
+    ctxt->queue = smi_watch_sub_queue_alloc(max_gpu);
+    if (!ctxt->queue) {
