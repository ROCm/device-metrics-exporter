+typedef struct aga_gpu_watch_power_gpu_s {
+    /// index of the GPU in the backend's GPU handle list
+    uint32_t gpu_idx;
+    /// uuid of the GPU, so the writer needs no GPU db lookup per frame
+    aga_obj_key_t gpu;
+    /// power tier values, in the frame's attr_id[] order; NA is UINT64_MAX
+    uint64_t val[AGA_GPU_WATCH_POWER_ATTRS_MAX];
+} aga_gpu_watch_power_gpu_t;
+
+/// \brief    partial (power tier only) GPU watch frame, one subscriber queue
+///           slot
+/// NOTE:
+/// variable length: gpu[] holds num_gpu entries, the slot is sized from the
+/// backend's GPU count at subscribe
+typedef struct aga_gpu_watch_power_frame_s {
+    /// gpu watch id
+    aga_obj_key_t watch_key;
+    /// power tick sequence number
+    uint64_t seq;
+    /// power ticks overrun by the smi-power thread so far
+    uint64_t missed_ticks;
+    /// number of GPUs in gpu[]
+    uint32_t num_gpu;
+    /// number of power tier attrs per GPU
+    uint32_t num_attrs;
+    /// power tier attrs refreshed this tick, in the watch spec order
+    aga_gpu_watch_attr_id_t attr_id[AGA_GPU_WATCH_POWER_ATTRS_MAX];
+    /// per GPU values
+    aga_gpu_watch_power_gpu_t gpu[];
+} aga_gpu_watch_power_frame_t;
