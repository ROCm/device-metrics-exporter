+void
+smi_watch_sub_reap (gpu_watch_subscriber_db_t *db,
+                    vector<gpu_watch_subscriber_info_t> *failed)
+{
+    uint64_t now_ns;
+    uint64_t dropped;
+    gpu_watch_sub_queue_t *q;
+
+    now_ns = smi_watch_mono_ns_();
+    for (auto& it : db->gpu_watch_map) {
+        for (auto client_ctxt : it.second.client_set) {
+            if (client_ctxt->write_failed.load(std::memory_order_acquire)) {
+                failed->push_back({ it.first, client_ctxt });
+                continue;
+            }
+            q = client_ctxt->queue.get();
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            if ((dropped == q->dropped_logged) ||
+                ((q->drop_warn_ns != 0) &&
+                 ((now_ns - q->drop_warn_ns) < k_sub_drop_warn_ns))) {
+                continue;
+            }
+            // the count is per subscriber (stream), whatever watch it is for
+            AGA_TRACE_WARN("GPU watch client {} is slow, {} frames dropped, "
+                           "{} in total", client_ctxt->client.c_str(),
+                           dropped - q->dropped_logged, dropped);
+            q->dropped_logged = dropped;
+            q->drop_warn_ns = now_ns;
+        }
+    }
+}
+
+void
+smi_watch_sub_client_release (aga_gpu_watch_client_ctxt_t *ctxt)
+{
+    // keep the queue (and its semaphore) alive past the release: the gRPC
+    // thread may free ctxt as soon as client_inactive is set
+    std::shared_ptr<gpu_watch_sub_queue_t> q = ctxt->queue;
+
+    ctxt->client_inactive.store(true, std::memory_order_release);
+    if (q) {
+        sem_post(&q->wake);
+    }
+}
+
+void
+smi_watch_sub_writer_loop (aga_gpu_watch_client_ctxt_t *ctxt)
+{
+    sdk_ret_t ret;
+    uint32_t tail;
+    uint64_t dropped;
+    struct timespec ts;
+    gpu_watch_sub_queue_t *q = ctxt->queue.get();
+    vector<std::shared_ptr<const aga_gpu_watch_info_t>> full;
+
+    while (!ctxt->client_inactive.load(std::memory_order_acquire)) {
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += k_sub_wait_secs;
+        // a timeout or EINTR only re-checks client_inactive
+        sem_timedwait(&q->wake, &ts);
+        if (ctxt->write_failed.load(std::memory_order_acquire)) {
+            // wait for the smi-watcher to remove this subscriber
+            continue;
+        }
+        ret = SDK_RET_OK;
+        {
+            std::lock_guard<std::mutex> lock(q->full_mu);
+
+            full.swap(q->full);
+        }
+        // full frames first: at sub-second periods they carry no POWER tier
+        // attrs, so they can never overwrite a newer power value. only on a
+        // period switch from sub-second to >= 1 s can power frames queued
+        // before the switch follow the first full frame with POWER values
+        // (one wake-up, at most the ring depth of older frames)
+        for (const auto& info : full) {
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            ret = ctxt->write_cb(info.get(), dropped, ctxt);
+            if (ret != SDK_RET_OK) {
+                break;
+            }
+        }
+        full.clear();
+        // then every queued power frame, in order
+        tail = q->tail.load(std::memory_order_relaxed);
+        while ((ret == SDK_RET_OK) &&
+               (tail != q->head.load(std::memory_order_acquire))) {
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            ret = ctxt->write_power_cb(smi_watch_sub_slot_(q, tail), dropped,
+                                       ctxt);
+            tail++;
+            // hand the slot back to the smi-power thread
+            q->tail.store(tail, std::memory_order_release);
+        }
+        if (ret != SDK_RET_OK) {
+            ctxt->write_failed.store(true, std::memory_order_release);
+        }
+    }
+}
