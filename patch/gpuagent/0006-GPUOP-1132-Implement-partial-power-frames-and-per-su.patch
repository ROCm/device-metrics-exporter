+        }
+        key = it.first;
+        AGA_TRACE_VERBOSE("GPU watch {} notify subscribers", key.str());
+        // heap-allocated: aga_gpu_watch_info_t is large; read once per watch
+        // and shared by all its subscribers until each one has written it
+        try {
+            info = std::make_shared<aga_gpu_watch_info_t>();
+        } catch (const std::bad_alloc&) {
