@@ -339,6 +331,28 @@ aga_gpu_watch_reset_fast_fields (aga_gpu_watch_fields_t *wi)
     wi->jpeg_busy_inst_count = 0;
 }
 
+/// \brief    reset the power-tier fields of a watch record to the NA sentinel
+/// the power tier (gpu metrics power family) is re-read by its owner every
+/// power tick from one gpu metrics read, so a failed read reports NA for the
+/// tick instead of a stale value
+static inline void
+aga_gpu_watch_reset_power_fields (aga_gpu_watch_fields_t *wi)
+{
+    wi->gfx_voltage = UINT64_MAX;
+    wi->soc_voltage = UINT64_MAX;
+    wi->mem_voltage = UINT64_MAX;
+    wi->viol_current_acc_counter = UINT64_MAX;
+    wi->viol_proc_hot_residency_acc = UINT64_MAX;
+    wi->viol_ppt_residency_acc = UINT64_MAX;
+    wi->viol_socket_thermal_residency_acc = UINT64_MAX;
+    wi->viol_vr_thermal_residency_acc = UINT64_MAX;
+    wi->viol_hbm_thermal_residency_acc = UINT64_MAX;
+    wi->gpu_power_usage = UINT64_MAX;
+    wi->energy_consumed = UINT64_MAX;
+    wi->firmware_timestamp = UINT64_MAX;
+    wi->system_clock_counter = UINT64_MAX;
+}
+
 typedef struct aga_gpu_watch_db_s {
     aga_gpu_watch_fields_t watch_info[AGA_MAX_GPU];
 } aga_gpu_watch_db_t;
