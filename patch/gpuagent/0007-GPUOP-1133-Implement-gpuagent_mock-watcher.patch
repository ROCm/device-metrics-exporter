+/// \brief    spawn the smi-watcher thread
+/// \return   SDK_RET_OK or error code in case of failure
+static sdk_ret_t
+spawn_watcher_thread_ (void)
+{
+    g_watcher_thread =
+        sdk::event_thread::event_thread::factory(
+            "smi-watcher", AGA_THREAD_ID_WATCHER,
+            sdk::lib::THREAD_ROLE_CONTROL, 0x0, mock_watcher_thread_init_,
+            mock_watcher_thread_exit_, NULL, // message
+            sdk::lib::thread::priority_by_role(sdk::lib::THREAD_ROLE_CONTROL),
+            sdk::lib::thread::sched_policy_by_role(
+                sdk::lib::THREAD_ROLE_CONTROL),
+            (THREAD_YIELD_ENABLE | THREAD_SYNC_IPC_ENABLE));
+    SDK_ASSERT_TRACE_RETURN((g_watcher_thread != NULL), SDK_RET_ERR,
+                            "GPU watcher thread create failure");
+    g_watcher_thread->start(NULL);
+    return SDK_RET_OK;
+}
