From fcf15186ee44aeffdb7f69dfe3816991d3395d3f Mon Sep 17 00:00:00 2001
From: praveen <praveenkumar.shanmugam@amd.com>
Date: Tue, 24 Nov 2026 19:58:58 -0800
Subject: [PATCH] GPUOP-1132: Fix multi-watch subscriber release use-after-free

smi_watch_sub_reap read write_failed once per (watch, client ctxt) pair.
The gRPC writer thread can set it between two of those reads, so a stream
subscribed to several watches was listed for only some of them. The
backend cleanup (amdsmi, gimamdsmi, wslamdsmi cleanup_gpu_watch_inactive_
subscribers_) erased the listed pairs and released the context, the gRPC
thread freed it, and the other watches kept a dangling pointer that the
next reap / notify dereferenced (heap-use-after-free).

The reap now decides failure once per context per pass and lists every
(watch, ctxt) pair of a failed context, so every cleanup erases all of its
memberships before it releases it. The backends are fixed through the
shared code and are unchanged. The gpuagent_mock cleanup no longer needs
its local all-watch sweep and is back to the amdsmi shape.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 sw/nic/gpuagent/api/smi/smi_api_mock.cc | 43 +++++++++++--------------
 sw/nic/gpuagent/api/smi/smi_watch.cc    | 19 ++++++++++-
 sw/nic/gpuagent/api/smi/smi_watch.hpp   |  7 +++-
 3 files changed, 42 insertions(+), 27 deletions(-)

diff --git a/sw/nic/gpuagent/api/smi/smi_api_mock.cc b/sw/nic/gpuagent/api/smi/smi_api_mock.cc
index 2e3358ccd8c..71da94a0728 100644
--- a/sw/nic/gpuagent/api/smi/smi_api_mock.cc
+++ b/sw/nic/gpuagent/api/smi/smi_api_mock.cc
@@ -1163,33 +1163,26 @@ mock_watch_cleanup_inactive_subscribers_ (
     sdk_ret_t ret;
     set<aga_gpu_watch_client_ctxt_t *> client_set;
 
+    // smi_watch_sub_reap lists a failed stream with every watch it is on, so
+    // erasing the listed pairs leaves no watch pointing at a released context
     for (auto& subscriber : subscribers) {
-        client_set.insert(subscriber.client_ctxt);
-    }
-    // the gRPC thread sets write_failed at any time, so a stream subscribed
-    // to several watches may be reaped for only some of them; erase every
-    // membership of a released stream, else a watch keeps a pointer to a
-    // context its gRPC thread frees after the release below
-    for (auto& it : g_gpu_watch_subscriber_db.gpu_watch_map) {
-        for (auto client_ctxt : client_set) {
-            aga_task_spec_t task_spec = {};
-
-            if (it.second.client_set.erase(client_ctxt) == 0) {
-                continue;
-            }
-            // one task per erased membership decrements its refcount
-            task_spec.task = AGA_TASK_GPU_WATCH_SUBSCRIBE_DEL;
-            task_spec.subscriber_spec.num_gpu_watch_ids = 1;
-            task_spec.subscriber_spec.gpu_watch_ids[0] = it.first;
-            ret = aga_task_create(&task_spec);
-            if (unlikely(ret != SDK_RET_OK)) {
-                AGA_TRACE_ERR("Failed to create task to decrement subscriber "
-                              "count for GPU watch {}, client {}, client "
-                              "ctxt {}", it.first.str(),
-                              client_ctxt->client.c_str(),
-                              (void *)client_ctxt);
-            }
+        aga_task_spec_t task_spec = {};
+
+        g_gpu_watch_subscriber_db.gpu_watch_map[subscriber.gpu_watch_id].
+            client_set.erase(subscriber.client_ctxt);
+        // one task per erased membership decrements its refcount
+        task_spec.task = AGA_TASK_GPU_WATCH_SUBSCRIBE_DEL;
+        task_spec.subscriber_spec.num_gpu_watch_ids = 1;
+        task_spec.subscriber_spec.gpu_watch_ids[0] = subscriber.gpu_watch_id;
+        ret = aga_task_create(&task_spec);
+        if (unlikely(ret != SDK_RET_OK)) {
+            AGA_TRACE_ERR("Failed to create task to decrement subscriber "
+                          "count for GPU watch {}, client {}, client "
+                          "ctxt {}", subscriber.gpu_watch_id.str(),
+                          subscriber.client_ctxt->client.c_str(),
+                          (void *)subscriber.client_ctxt);
         }
+        client_set.insert(subscriber.client_ctxt);
     }
     // the smi-power thread must stop sampling for erased subscribers
     if (!subscribers.empty()) {
diff --git a/sw/nic/gpuagent/api/smi/smi_watch.cc b/sw/nic/gpuagent/api/smi/smi_watch.cc
index 71386efe90c..553152e8397 100644
--- a/sw/nic/gpuagent/api/smi/smi_watch.cc
+++ b/sw/nic/gpuagent/api/smi/smi_watch.cc
@@ -967,12 +967,22 @@ smi_watch_sub_reap (gpu_watch_subscriber_db_t *db,
     uint64_t now_ns;
     uint64_t dropped;
     gpu_watch_sub_queue_t *q;
+    unordered_map<aga_gpu_watch_client_ctxt_t *, bool> failed_of;
 
     now_ns = smi_watch_mono_ns_();
+    // the gRPC thread sets write_failed at any time, so it is read once per
+    // subscriber per pass: a stream on several watches is then listed with
+    // all of its (watch, ctxt) pairs or none, and the caller can erase every
+    // membership before it releases the context
     for (auto& it : db->gpu_watch_map) {
         for (auto client_ctxt : it.second.client_set) {
+            auto res = failed_of.emplace(client_ctxt, false);
+
+            if (!res.second) {
+                continue;
+            }
             if (client_ctxt->write_failed.load(std::memory_order_acquire)) {
-                failed->push_back({ it.first, client_ctxt });
+                res.first->second = true;
                 continue;
             }
             q = client_ctxt->queue.get();
@@ -990,6 +1000,13 @@ smi_watch_sub_reap (gpu_watch_subscriber_db_t *db,
             q->drop_warn_ns = now_ns;
         }
     }
+    for (auto& it : db->gpu_watch_map) {
+        for (auto client_ctxt : it.second.client_set) {
+            if (failed_of[client_ctxt]) {
+                failed->push_back({ it.first, client_ctxt });
+            }
+        }
+    }
 }
 
 void
diff --git a/sw/nic/gpuagent/api/smi/smi_watch.hpp b/sw/nic/gpuagent/api/smi/smi_watch.hpp
index e1645a97bc0..55041515fbb 100644
--- a/sw/nic/gpuagent/api/smi/smi_watch.hpp
+++ b/sw/nic/gpuagent/api/smi/smi_watch.hpp
@@ -301,8 +301,13 @@ void smi_watch_notify_full(gpu_watch_subscriber_db_t *db, bool skip_power);
 
 /// \brief    collect subscribers whose write failed and log grown drop
 ///           counts, rate limited per subscriber (smi-watcher, every tick)
+/// NOTE:
+/// write_failed is read once per subscriber, so a failed subscriber is listed
+/// with every watch it is on; the caller must erase all the listed pairs
+/// before it releases any of their contexts
 /// \param[in]  db        subscriber db
-/// \param[out] failed    subscribers to clean up
+/// \param[out] failed    subscribers to clean up, one entry per (watch,
+///                       subscriber) pair
 void smi_watch_sub_reap(gpu_watch_subscriber_db_t *db,
                         vector<gpu_watch_subscriber_info_t> *failed);
 
-- 
