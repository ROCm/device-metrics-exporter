+void
+smi_state::power_view_rebuild_(void) {
+    gpu_entry *gpu;
+    aga_obj_key_t key;
+    gpu_watch_power_view_t::watch_t watch;
+    std::shared_ptr<gpu_watch_power_view_t> view;
+    // heap-allocated: aga_gpu_watch_info_t is large; only on (un)subscribe
+    std::unique_ptr<aga_gpu_watch_info_t> info(new aga_gpu_watch_info_t());
+
+    view = std::make_shared<gpu_watch_power_view_t>();
+    for (auto& it : gpu_watch_subscriber_db_.gpu_watch_map) {
+        if (it.second.client_set.empty()) {
+            continue;
+        }
+        key = it.first;
+        memset(info.get(), 0, sizeof(aga_gpu_watch_info_t));
+        if (aga_gpu_watch_read(&key, info.get()) != SDK_RET_OK) {
+            continue;
+        }
+        watch = {};
+        watch.key = key;
+        for (uint32_t i = 0; i < info->spec.num_attrs; i++) {
+            if ((smi_watch_attr_tier(info->spec.attr_id[i]) ==
+                     GPU_WATCH_TIER_POWER) &&
+                (watch.num_attrs < AGA_GPU_WATCH_POWER_ATTRS_MAX)) {
+                watch.attr_id[watch.num_attrs++] = info->spec.attr_id[i];
+            }
+        }
+        for (uint32_t g = 0; g < info->spec.num_gpu; g++) {
+            gpu = gpu_db()->find(&info->spec.gpu[g]);
+            if ((gpu != NULL) && (gpu->id() < num_gpu_)) {
+                watch.gpu_idx[watch.num_gpu++] = gpu->id();
+            }
+        }
+        if ((watch.num_attrs == 0) || (watch.num_gpu == 0)) {
+            continue;
+        }
+        for (uint32_t g = 0; g < watch.num_gpu; g++) {
+            view->gpus.set(watch.gpu_idx[g]);
+        }
+        view->watches.push_back(watch);
+    }
+    AGA_TRACE_DEBUG("Power view rebuilt, {} watches, {} GPUs",
+                    view->watches.size(), view->gpus.count());
+    smi_watch_power_view_set(view);
+}
+
 static void
 gpu_watch_subscribe_ipc_cb_ (sdk::ipc::ipc_msg_ptr msg, const void *ctxt)
 {
@@ -1651,6 +1709,9 @@ watcher_thread_init_ (void *ctxt)
     static event::timer_t watch_timer;
 
     g_smi_state.watcher_init();
+    // power tier sampler, parked until a sub-second period is subscribed;
+    // a failure is logged and the POWER tier stays with this thread
+    smi_watch_power_thread_start(g_smi_state.num_gpu());
     // register for gpu watch subscribe messages
     sdk::ipc::reg_request_handler(AGA_IPC_MSG_ID_GPU_WATCH_SUBSCRIBE,
                                   gpu_watch_subscribe_ipc_cb_, NULL);
@@ -2141,8 +2202,10 @@ smi_state::teardown (void)
     if (!initialized_) {
         return SDK_RET_OK;
     }
-    // stop the watcher thread before shutting down the SMI library to
-    // avoid racing with the watcher timer callback which calls SMI APIs
+    // stop the watcher threads before shutting down the SMI library to
+    // avoid racing with their SMI calls; the smi-power thread goes first,
+    // before the smi-watcher that publishes its power view
+    smi_watch_power_thread_stop();
     if (watcher_thread_) {
         watcher_thread_->stop();
         watcher_thread_->wait();
@@ -2155,6 +2218,26 @@ smi_state::teardown (void)
     return SDK_RET_OK;
 }
 
+sdk_ret_t
+smi_watch_power_read (uint32_t gpu_idx, aga_gpu_watch_fields_t *fields)
+{
+    amdsmi_status_t amdsmi_ret;
+    amdsmi_gpu_metrics_t gpu_metrics = { 0 };
+
+    if (gpu_idx >= g_smi_state.num_gpu()) {
+        return SDK_RET_INVALID_ARG;
+    }
+    // one bulk read and nothing else: no other SMI, sysfs or PMFW call and
+    // no fallback, so the power tick stays short
+    amdsmi_ret = amdsmi_get_gpu_metrics_info(g_smi_state.gpu_handle(gpu_idx),
+                                             &gpu_metrics);
+    if (amdsmi_ret != AMDSMI_STATUS_SUCCESS) {
+        return amdsmi_ret_to_sdk_ret(amdsmi_ret);
+    }
+    smi_watch_fill_power_fields(&gpu_metrics, fields);
+    return SDK_RET_OK;
+}
+
 /// \@}
 
 }    // namespace aga
