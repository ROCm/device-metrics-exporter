+sdk_ret_t
+smi_watch_power_read (uint32_t gpu_idx, aga_gpu_watch_fields_t *fields)
+{
+    uint64_t n;
+    uint64_t mono_ns;
+    struct timespec ts;
+    static uint64_t num_reads[AGA_MAX_GPU];
+
+    if (gpu_idx >= AGA_MAX_GPU) {
+        return SDK_RET_INVALID_ARG;
     }
+    // synthetic power tier values, monotonic per GPU; only the smi-power
+    // thread calls this hook
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    mono_ns = ((uint64_t)ts.tv_sec * 1000000000ull) + (uint64_t)ts.tv_nsec;
+    n = ++num_reads[gpu_idx];
+    fields->gpu_power_usage = 300 + gpu_idx + (n % 50);
+    fields->gfx_voltage = 800;
+    fields->soc_voltage = 900;
+    fields->mem_voltage = 1100;
+    fields->energy_consumed = n * 300;
+    fields->viol_current_acc_counter = n;
+    fields->viol_proc_hot_residency_acc = n / 10;
+    fields->viol_ppt_residency_acc = n / 10;
+    fields->viol_socket_thermal_residency_acc = n / 10;
+    fields->viol_vr_thermal_residency_acc = n / 10;
+    fields->viol_hbm_thermal_residency_acc = n / 10;
+    fields->firmware_timestamp = mono_ns / 10;
+    fields->system_clock_counter = mono_ns;
     return SDK_RET_OK;
 }
 
