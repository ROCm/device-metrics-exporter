From 109213b0ec21bef516ae2f228d9eef244b19c7f3 Mon Sep 17 00:00:00 2001
From: Bhanu Kiran Atturu <bhatturu@amd.com>
Date: Fri, 13 Nov 2026 18:44:03 -0500
Subject: [PATCH] feat(gpu): expose asic market name in GPUStatus

Board FRU fields can be blank (MI350P), leaving no product identity.
Add MarketName (field 31) from amdsmi_get_gpu_asic_info(), which is
device-id based, and show it in gpuctl.
---
 sw/nic/gpuagent/api/include/aga_gpu.hpp      |  2 ++
 sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc    | 17 ++++++++++++-----
 sw/nic/gpuagent/api/smi/gimamdsmi/smi_api.cc | 10 ++++++++++
 sw/nic/gpuagent/api/smi/smi_api_mock.cc      |  1 +
 sw/nic/gpuagent/api/smi/wslamdsmi/smi_api.cc | 17 ++++++++++++-----
 sw/nic/gpuagent/cli/cmd/gpu.go               |  3 +++
 sw/nic/gpuagent/protos/gpu.proto             |  2 ++
 sw/nic/gpuagent/svc/gpu_to_proto.hpp         |  1 +
 8 files changed, 43 insertions(+), 10 deletions(-)

diff --git a/sw/nic/gpuagent/api/include/aga_gpu.hpp b/sw/nic/gpuagent/api/include/aga_gpu.hpp
index a7c5b7efdf4..6e6ca8f9740 100644
--- a/sw/nic/gpuagent/api/include/aga_gpu.hpp
+++ b/sw/nic/gpuagent/api/include/aga_gpu.hpp
@@ -566,6 +566,8 @@ typedef struct aga_gpu_status_s {
     aga_gpu_virtualization_mode_t virtualization_mode;
     // GPU process status
     aga_gpu_process_info_t process_info[AGA_GPU_MAX_PROCESS_PER_DEVICE];
+    /// device-id based product name from asic info
+    char market_name[AGA_MAX_STR_LEN + 1];
 } aga_gpu_status_t;
 
 /// \brief GPU PCIe statistics
diff --git a/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc b/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
index ce1e3089703..357e278a0dc 100644
--- a/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
+++ b/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
@@ -2284,14 +2284,21 @@ smi_gpu_init_immutable_attrs (aga_gpu_handle_t gpu_handle,
     // fill the GPU card model
     strncpy(status->card_model, board_info.model_number, AGA_MAX_STR_LEN);
     status->card_model[AGA_MAX_STR_LEN] = '\0';
+    // market name is device-id based, so it is present even when the board
+    // FRU fields are blank (e.g. MI350P)
+    amdsmi_ret = amdsmi_get_gpu_asic_info(gpu_handle, &asic_info);
+    if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
+        AGA_TRACE_ERR("Failed to get asic info for GPU {}, err {}",
+                      gpu_handle, amdsmi_ret);
+    } else {
+        strncpy(status->market_name, asic_info.market_name, AGA_MAX_STR_LEN);
+        status->market_name[AGA_MAX_STR_LEN] = '\0';
+    }
     // consumer GPUs leave board_info marketing fields empty; fall back to the
     // driver-reported market name from asic_info
     if ((status->card_model[0] == '\0') || (!strcmp(status->card_model, "N/A"))) {
-        amdsmi_ret = amdsmi_get_gpu_asic_info(gpu_handle, &asic_info);
-        if ((amdsmi_ret == AMDSMI_STATUS_SUCCESS) &&
-            (asic_info.market_name[0] != '\0')) {
-            strncpy(status->card_model, asic_info.market_name,
-                    AGA_MAX_STR_LEN);
+        if (status->market_name[0] != '\0') {
+            strncpy(status->card_model, status->market_name, AGA_MAX_STR_LEN);
             status->card_model[AGA_MAX_STR_LEN] = '\0';
         }
     }
diff --git a/sw/nic/gpuagent/api/smi/gimamdsmi/smi_api.cc b/sw/nic/gpuagent/api/smi/gimamdsmi/smi_api.cc
index 7b2175252e7..8029abb971a 100644
--- a/sw/nic/gpuagent/api/smi/gimamdsmi/smi_api.cc
+++ b/sw/nic/gpuagent/api/smi/gimamdsmi/smi_api.cc
@@ -1637,6 +1637,7 @@ smi_gpu_init_immutable_attrs (aga_gpu_handle_t gpu_handle_in,
     amdsmi_status_t amdsmi_ret;
     amdsmi_vbios_info_t vbios_info;
     amdsmi_board_info_t board_info = {};
+    amdsmi_asic_info_t asic_info = {};
     amdsmi_driver_info_t driver_info = {};
     amdsmi_virtualization_mode_t mode;
 
@@ -1670,6 +1671,15 @@ smi_gpu_init_immutable_attrs (aga_gpu_handle_t gpu_handle_in,
     memcpy(status->card_vendor, board_info.manufacturer_name, AGA_MAX_STR_LEN);
     // fill the GPU card model
     memcpy(status->card_model, board_info.model_number, AGA_MAX_STR_LEN);
+    // fill the device-id based market name
+    amdsmi_ret = amdsmi_get_gpu_asic_info(gpu_handle, &asic_info);
+    if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
+        AGA_TRACE_ERR("Failed to get asic info for GPU {}, err {}",
+                      gpu_handle, amdsmi_ret);
+    } else {
+        strncpy(status->market_name, asic_info.market_name, AGA_MAX_STR_LEN);
+        status->market_name[AGA_MAX_STR_LEN] = '\0';
+    }
     // fill the driver version
     amdsmi_ret = amdsmi_get_gpu_driver_info(gpu_handle, &driver_info);
     if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
diff --git a/sw/nic/gpuagent/api/smi/smi_api_mock.cc b/sw/nic/gpuagent/api/smi/smi_api_mock.cc
index 434dbdf041f..ad4a70b55d7 100644
--- a/sw/nic/gpuagent/api/smi/smi_api_mock.cc
+++ b/sw/nic/gpuagent/api/smi/smi_api_mock.cc
@@ -227,6 +227,7 @@ smi_gpu_fill_status (aga_gpu_handle_t gpu_handle,
             AGA_MAX_STR_LEN);
     // fill the GPU card model
     strncpy(status->card_model, "102-G30211-00", AGA_MAX_STR_LEN);
+    strncpy(status->market_name, "AMD Instinct MI300X", AGA_MAX_STR_LEN);
     // fill the GPU vendor information
     strncpy(status->card_vendor, "Advanced Micro Devices, Inc. [AMD/ATI]",
             AGA_MAX_STR_LEN);
diff --git a/sw/nic/gpuagent/api/smi/wslamdsmi/smi_api.cc b/sw/nic/gpuagent/api/smi/wslamdsmi/smi_api.cc
index e124930a335..aeb0c149f21 100644
--- a/sw/nic/gpuagent/api/smi/wslamdsmi/smi_api.cc
+++ b/sw/nic/gpuagent/api/smi/wslamdsmi/smi_api.cc
@@ -2342,14 +2342,21 @@ smi_gpu_init_immutable_attrs (aga_gpu_handle_t gpu_handle,
     // fill the GPU card model
     strncpy(status->card_model, board_info.model_number, AGA_MAX_STR_LEN);
     status->card_model[AGA_MAX_STR_LEN] = '\0';
+    // market name is device-id based, so it is present even when the board
+    // FRU fields are blank (e.g. MI350P)
+    amdsmi_ret = amdsmi_get_gpu_asic_info(gpu_handle, &asic_info);
+    if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
+        AGA_TRACE_ERR("Failed to get asic info for GPU {}, err {}",
+                      gpu_handle, amdsmi_ret);
+    } else {
+        strncpy(status->market_name, asic_info.market_name, AGA_MAX_STR_LEN);
+        status->market_name[AGA_MAX_STR_LEN] = '\0';
+    }
     // consumer GPUs leave board_info marketing fields empty; fall back to the
     // driver-reported market name from asic_info
     if ((status->card_model[0] == '\0') || (!strcmp(status->card_model, "N/A"))) {
-        amdsmi_ret = amdsmi_get_gpu_asic_info(gpu_handle, &asic_info);
-        if ((amdsmi_ret == AMDSMI_STATUS_SUCCESS) &&
-            (asic_info.market_name[0] != '\0')) {
-            strncpy(status->card_model, asic_info.market_name,
-                    AGA_MAX_STR_LEN);
+        if (status->market_name[0] != '\0') {
+            strncpy(status->card_model, status->market_name, AGA_MAX_STR_LEN);
             status->card_model[AGA_MAX_STR_LEN] = '\0';
         }
     }
diff --git a/sw/nic/gpuagent/cli/cmd/gpu.go b/sw/nic/gpuagent/cli/cmd/gpu.go
index db31f6b1ab2..f99173b0af6 100644
--- a/sw/nic/gpuagent/cli/cmd/gpu.go
+++ b/sw/nic/gpuagent/cli/cmd/gpu.go
@@ -905,6 +905,9 @@ func printGPUStatus(gpu *aga.GPU, statusOnly bool) {
 	if strings.TrimSpace(status.GetCardSKU()) != "" {
 		fmt.Printf(indent+"%-38s : %s\n", "Card SKU", status.GetCardSKU())
 	}
+	if strings.TrimSpace(status.GetMarketName()) != "" {
+		fmt.Printf(indent+"%-38s : %s\n", "Market name", status.GetMarketName())
+	}
 	if strings.TrimSpace(status.GetDriverVersion()) != "" {
 		fmt.Printf(indent+"%-38s : %s\n", "Driver version",
 			status.GetDriverVersion())
diff --git a/sw/nic/gpuagent/protos/gpu.proto b/sw/nic/gpuagent/protos/gpu.proto
index e932c1f1773..8de1ecd863b 100644
--- a/sw/nic/gpuagent/protos/gpu.proto
+++ b/sw/nic/gpuagent/protos/gpu.proto
@@ -456,6 +456,8 @@ message GPUStatus {
   GPUVirtualizationMode       VirtualizationMode = 29;
   // GPU process information
   GPUProcessStatus            ProcessStatus      = 30;
+  // device-id based product name (amdsmi asic market name)
+  string                      MarketName         = 31;
 }
 
 // GPU temperature information
diff --git a/sw/nic/gpuagent/svc/gpu_to_proto.hpp b/sw/nic/gpuagent/svc/gpu_to_proto.hpp
index 329ae3a55ae..9741d4d8676 100644
--- a/sw/nic/gpuagent/svc/gpu_to_proto.hpp
+++ b/sw/nic/gpuagent/svc/gpu_to_proto.hpp
@@ -416,6 +416,7 @@ aga_gpu_api_status_to_proto (GPUStatus *proto_status,
     proto_status->set_cardmodel(status->card_model);
     proto_status->set_cardvendor(status->card_vendor);
     proto_status->set_cardsku(status->card_sku);
+    proto_status->set_marketname(status->market_name);
     proto_status->set_driverversion(status->driver_version);
     proto_status->set_vbiosversion(status->vbios_version);
     proto_status->set_vbiospartnumber(status->vbios_part_number);
-- 
2.55.0

