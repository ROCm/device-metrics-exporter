 #include <unordered_set>
 extern "C" {
 #include "nic/third-party/rocm/amd_smi_lib/include/amd_smi/amdsmi.h"
@@ -54,6 +56,33 @@
 /// status and statistics
 std::mutex g_gpu_metrics_mutex;
 std::unordered_map<aga_gpu_handle_t, amdsmi_gpu_metrics_t> g_gpu_metrics;
+/// TEST(option#3): wall-clock secs of the watcher's last g_gpu_metrics refresh;
+/// the GpuGet path treats the watcher as the sole amdsmi_get_gpu_metrics_info
+/// caller while this is fresh (amdsmi SO27 gpu_metrics cache is not safe against
+/// concurrent callers). 0 => watcher not active, fall back to per-GpuGet fetch
+static std::atomic<uint64_t> g_gpu_metrics_cache_ts{0};
+/// freshness window (secs): generous vs the fast-tier period + jitter
+#define GPU_METRICS_CACHE_FRESH_SECS   10ULL
+
+void
+smi_watcher_cache_gpu_metrics (aga_gpu_handle_t gpu_handle,
+                               const amdsmi_gpu_metrics_t *metrics) {
+    {
+        std::lock_guard<std::mutex> lock(g_gpu_metrics_mutex);
+        g_gpu_metrics[gpu_handle] = *metrics;
+    }
+    g_gpu_metrics_cache_ts.store((uint64_t)time(NULL),
+                                 std::memory_order_relaxed);
+}
+
+bool
+smi_watcher_metrics_cache_active (void) {
+    uint64_t ts = g_gpu_metrics_cache_ts.load(std::memory_order_relaxed);
+    if (ts == 0) {
+        return false;
+    }
+    return ((uint64_t)time(NULL) - ts) <= GPU_METRICS_CACHE_FRESH_SECS;
+}
