Subject: [PATCH] gpuagent: version-proof clk-limit enum for amdsmi 26/27

gpuagent 22f92dc already uses the new amdsmi_set_gpu_clk_limit() (present in
every amdsmi DME stages: lib26 26.5.0, therock-10.0, therock-10.1), but passes
the AMDSMI_CLK_LIMIT_MIN/MAX enumerators, which exist ONLY in therock-10.1.
lib26 and therock-10.0 provide only the legacy CLK_LIMIT_MIN/MAX spelling.
A version macro cannot discriminate -- 10.0 and 10.1 are both
AMDSMI_LIB_VERSION_MAJOR=27 -- and the enum constants are not #defines, so
#ifdef is always false.

Pass the limit type by its ABI-stable integer value instead of either
spelling. amdsmi_clk_limit_type_t is MIN=0, MAX=1 in all three headers, so the
cast compiles against every amdsmi DME may stage and survives a future header
that drops the deprecated CLK_LIMIT_* aliases.

--- a/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
+++ b/sw/nic/gpuagent/api/smi/amdsmi/smi_api.cc
@@ -1826,7 +1826,7 @@
                 return SDK_RET_INVALID_ARG;
             }
             amdsmi_ret = amdsmi_set_gpu_clk_limit(gpu_handle, clock_type,
-                             AMDSMI_CLK_LIMIT_MIN, spec->clock_freq[i].lo);
+                             (amdsmi_clk_limit_type_t)0 /*MIN*/, spec->clock_freq[i].lo);
             if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
                 AGA_TRACE_ERR("Failed to set clock {} min frequency, GPU {}, "
                               "min {}, err {}",
@@ -1835,7 +1835,7 @@
                 return (amdsmi_ret_to_sdk_ret(amdsmi_ret));
             }
             amdsmi_ret = amdsmi_set_gpu_clk_limit(gpu_handle, clock_type,
-                             AMDSMI_CLK_LIMIT_MAX, spec->clock_freq[i].hi);
+                             (amdsmi_clk_limit_type_t)1 /*MAX*/, spec->clock_freq[i].hi);
             if (unlikely(amdsmi_ret != AMDSMI_STATUS_SUCCESS)) {
                 AGA_TRACE_ERR("Failed to set clock {} max frequency, GPU {}, "
                               "max {}, err {}",
