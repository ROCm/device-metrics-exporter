+/// \brief    check a non-zero watcher fast period, in ms
+/// \param[in] ms    fast period in milliseconds
+/// \return   true for 1, 10, 100, or a multiple of 1000 within 1000-60000
+static inline bool
+aga_gpu_watch_fast_period_ms_valid (uint32_t ms)
+{
+    if ((ms == 1) || (ms == 10) || (ms == 100)) {
+        return true;
+    }
+    return ((ms >= AGA_GPU_WATCH_FAST_TIER_MIN_MS) &&
+            (ms <= AGA_GPU_WATCH_FAST_PERIOD_MS_MAX) && ((ms % 1000) == 0));
+}
 
