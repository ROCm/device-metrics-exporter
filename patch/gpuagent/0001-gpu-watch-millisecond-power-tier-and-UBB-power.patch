+// populate a full frame of the subscribe stream: the GPU watch info plus the
+// frames dropped for the receiving subscriber in MissedTicks
+static inline void
+aga_gpu_watch_full_frame_to_proto (amdgpu::GPUWatch *proto_info,
+                                   const aga_gpu_watch_info_t *info,
+                                   uint64_t dropped)
+{
+    aga_gpu_watch_info_to_proto(proto_info, info);
+    proto_info->mutable_status()->set_missedticks(info->status.missed_ticks +
+                                                  dropped);
+}
+
+// populate a partial (power tier only) frame of the subscribe stream: Spec
+// carries only the watch Id (an empty Attribute list marks a partial frame),
+// Status only MissedTicks, and Stats per GPU only the power tier attrs
+// refreshed this tick, as {Id, Value.LongVal} without Units
+static inline void
+aga_gpu_watch_power_frame_to_proto (amdgpu::GPUWatch *proto_info,
+                                    const aga_gpu_watch_power_frame_t *frame,
+                                    uint64_t dropped)
+{
+    amdgpu::GPUWatchStats *proto_stats;
+    const aga_gpu_watch_power_gpu_t *gpu;
+
+    proto_info->mutable_spec()->set_id(frame->watch_key.id, OBJ_MAX_KEY_LEN);
+    proto_info->mutable_status()->set_missedticks(frame->missed_ticks +
+                                                  dropped);
+    proto_stats = proto_info->mutable_stats();
+    for (uint32_t i = 0; i < frame->num_gpu; i++) {
+        auto gpu_watch_attr = proto_stats->add_gpuwatchattr();
+
+        gpu = &frame->gpu[i];
+        gpu_watch_attr->set_gpu(gpu->gpu.id, OBJ_MAX_KEY_LEN);
+        for (uint32_t j = 0; j < frame->num_attrs; j++) {
+            auto proto_attr = gpu_watch_attr->add_attr();
+
+            proto_attr->set_id(aga_gpu_watch_attr_id_to_proto(
+                                   frame->attr_id[j]));
+            proto_attr->mutable_value()->set_longval(gpu->val[j]);
+        }
+    }
+}
