+/// \brief    fill the POWER tier fields of one GPU with synthetic values
+/// NOTE:
+/// deterministic and monotonic per GPU: accumulation counter +1 per read,
+/// energy += power x period, residency +1 every 10 reads, power
+/// 300 + gpu + (read % 50) W, constant voltages, timestamps from
+/// CLOCK_MONOTONIC. fields named in AGA_MOCK_POWER_NA_FIELDS read NA
+/// \param[in]  gpu_idx      GPU index, below AGA_MAX_GPU
+/// \param[in]  period_ms    cadence of the caller, for the energy integral
+/// \param[out] fields       watch record whose POWER tier fields are filled
+static void
+mock_power_fill_ (uint32_t gpu_idx, uint32_t period_ms,
+                  aga_gpu_watch_fields_t *fields)
+{
+    uint64_t n;
+    uint64_t power;
+    uint64_t energy;
+    uint64_t mono_ns;
+    uint32_t na_mask = mock_watch_knobs_()->na_mask;
+
+    mono_ns = mock_mono_ns_();
+    n = g_mock_power_reads[gpu_idx].fetch_add(1, std::memory_order_relaxed) + 1;
+    power = 300 + gpu_idx + (n % 50);
+    // W x ms = mJ, x 1000 = uJ
+    energy = g_mock_power_energy[gpu_idx].fetch_add(power * period_ms * 1000,
+                                                    std::memory_order_relaxed);
+    fields->gpu_power_usage = power;
+    fields->gfx_voltage = 800;
+    fields->soc_voltage = 900;
+    fields->mem_voltage = 1100;
+    fields->energy_consumed = energy + (power * period_ms * 1000);
+    fields->viol_current_acc_counter = n;
+    fields->viol_proc_hot_residency_acc = n / 10;
+    fields->viol_ppt_residency_acc = n / 10;
+    fields->viol_socket_thermal_residency_acc = n / 10;
+    fields->viol_vr_thermal_residency_acc = n / 10;
+    fields->viol_hbm_thermal_residency_acc = n / 10;
+    fields->firmware_timestamp = mono_ns / 10;
+    fields->system_clock_counter = mono_ns;
+    for (uint32_t i = 0; na_mask != 0; i++, na_mask >>= 1) {
+        if (na_mask & 1) {
+            fields->*k_mock_power_fields[i].field = UINT64_MAX;
+        }
+    }
+}
+
+/// \brief    fill the FAST tier fields of one GPU with synthetic values
+/// NOTE:
+/// GPU_CLOCK = 1000 + FAST sweep sequence; the rest are the mock's GPU stats
+/// values. UBB node power is FAST (1 s floor) and every mock GPU is partition
+/// 0, so it is read on every FAST sweep and carried forward in between
+/// \param[in]  gpu_idx    GPU index
+/// \param[out] fields     watch record whose FAST tier fields are filled
+static void
+mock_watch_fill_fast_ (uint32_t gpu_idx, aga_gpu_watch_fields_t *fields)
+{
+    uint64_t seq = g_mock_fast_seq;
+
+    fields->gpu_clock = 1000 + seq;
+    fields->memory_clock = 900;
+    fields->gpu_temperature = 45 + gpu_idx;
+    fields->memory_temperature = 50 + gpu_idx;
+    fields->power_usage = 90 + gpu_idx;
+    fields->avg_power = 90 + gpu_idx;
+    fields->gpu_util = seq % 100;
+    fields->umc_activity = 30;
+    fields->mm_activity = 10;
+    fields->vram_max_bandwidth = 3276800;
+    fields->edge_temperature = 40 + gpu_idx;
+    fields->pcie_replay_count = seq;
+    fields->pcie_recovery_count = seq;
+    fields->pcie_replay_rollover_count = seq;
+    fields->pcie_nack_sent_count = seq;
+    fields->pcie_nack_received_count = seq;
+    fields->ubb_power = 2100 + (seq % 50);
+    fields->hbm_temperature_count = AGA_GPU_MAX_HBM;
+    fields->gfx_busy_inst_count = AGA_GPU_MAX_XCC;
+    for (uint32_t i = 0; i < AGA_GPU_MAX_XCC; i++) {
+        if (i < AGA_GPU_MAX_HBM) {
+            fields->hbm_temperature[i] = 50 + i;
+        }
+        fields->gfx_busy_inst[i] = (seq + i) % 100;
+    }
+}
+
+/// \brief    fill the SLOW tier fields of one GPU with synthetic values
+/// NOTE:
+/// ECC_CORRECT_TOTAL = SLOW sweep sequence; the rest are the mock's GPU
+/// stats values
+/// \param[in]  gpu_idx    GPU index
+/// \param[out] fields     watch record whose SLOW tier fields are filled
+static void
+mock_watch_fill_slow_ (uint32_t gpu_idx, aga_gpu_watch_fields_t *fields)
+{
+    uint64_t seq = g_mock_slow_seq;
+
+    fields->total_correctable_errors = seq;
+    fields->total_uncorrectable_errors = 0;
+    fields->total_deferred_errors = 0;
+    fields->pcie_tx_usage = 1000 + seq;
+    fields->pcie_rx_usage = 2000 + seq;
+    fields->pcie_bandwidth = 315;
+    fields->gpu_memory_usage = 1273;
+    fields->gpu_total_memory = 196592;
+    fields->total_vram = 196592;
+    fields->total_visible_vram = 196592;
+    fields->total_gtt = 128716;
+    fields->used_visible_vram = 1273;
+    fields->used_gtt = 20;
+    fields->free_vram = 196592 - 1273;
+    fields->free_visible_vram = 196592 - 1273;
+    fields->free_gtt = 128716 - 20;
+    fields->pcie_speed = 16;
+    fields->pcie_max_speed = 32;
+    fields->xgmi_neighbor0_tx_throughput = seq * 32;
+    fields->xgmi_neighbor1_tx_throughput = seq * 32;
+}
