+
+//----------------------------------------------------------------------------
+// smi-power thread: samples the POWER tier every sub-second fast period
+//----------------------------------------------------------------------------
+
+/// number of POWER tier attrs
+static constexpr uint32_t k_num_power_attrs =
+    sizeof(k_power_attrs) / sizeof(k_power_attrs[0]);
+/// seqlock read attempts before a possibly torn copy is used
+static constexpr uint32_t k_power_snapshot_tries = 64;
+/// seqlock read attempts spent spinning before yielding to the writer
+static constexpr uint32_t k_power_snapshot_spins = 8;
+/// smi-power park wait, re-checking the period and the power view
+static constexpr uint64_t k_power_park_ns = 100ull * 1000000ull;
+/// minimum interval between two overrun warnings
+static constexpr uint64_t k_power_warn_ns = 10ull * 1000000000ull;
+/// minimum interval between two drop warnings of one subscriber
+static constexpr uint64_t k_sub_drop_warn_ns = 10ull * 1000000000ull;
+/// subscriber writer wait, re-checking client_inactive
+static constexpr long k_sub_wait_secs = 1;
+
+/// watch record field of each k_power_attrs[] entry, in the same order
+static uint64_t aga_gpu_watch_fields_t::* const k_power_fields[] = {
+    &aga_gpu_watch_fields_t::gfx_voltage,
+    &aga_gpu_watch_fields_t::soc_voltage,
+    &aga_gpu_watch_fields_t::mem_voltage,
+    &aga_gpu_watch_fields_t::viol_current_acc_counter,
+    &aga_gpu_watch_fields_t::viol_proc_hot_residency_acc,
+    &aga_gpu_watch_fields_t::viol_ppt_residency_acc,
+    &aga_gpu_watch_fields_t::viol_socket_thermal_residency_acc,
+    &aga_gpu_watch_fields_t::viol_vr_thermal_residency_acc,
+    &aga_gpu_watch_fields_t::viol_hbm_thermal_residency_acc,
+    &aga_gpu_watch_fields_t::gpu_power_usage,
+    &aga_gpu_watch_fields_t::energy_consumed,
+    &aga_gpu_watch_fields_t::firmware_timestamp,
+    &aga_gpu_watch_fields_t::system_clock_counter,
+};
+static_assert((sizeof(k_power_fields) / sizeof(k_power_fields[0])) ==
+                  k_num_power_attrs,
+              "k_power_fields must map every k_power_attrs entry");
+static_assert(k_num_power_attrs <= AGA_GPU_WATCH_POWER_ATTRS_MAX,
+              "POWER tier attrs exceed AGA_GPU_WATCH_POWER_ATTRS_MAX");
+
+/// \brief    POWER tier record of one GPU
+/// NOTE:
+/// written by the smi-power thread only; read with the seqlock protocol, seq
+/// is odd while a write is in progress. values are atomics so a concurrent
+/// read is never a data race
+typedef struct gpu_watch_power_rec_s {
+    std::atomic<uint32_t> seq;
+    std::atomic<uint64_t> val[AGA_GPU_WATCH_POWER_ATTRS_MAX];
+} gpu_watch_power_rec_t;
+
+/// per GPU POWER tier record
+static gpu_watch_power_rec_t g_power_rec[AGA_MAX_GPU];
+/// per GPU, true while the smi-power thread samples the GPU's record
+static std::atomic<bool> g_power_owned[AGA_MAX_GPU];
+/// power ticks overrun while the smi-power thread was active
+static std::atomic<uint64_t> g_missed_ticks{0};
+/// asks the smi-power thread to exit
+static std::atomic<bool> g_power_stop{false};
+/// starting the smi-power thread was attempted and failed
+static std::atomic<bool> g_power_failed{false};
+/// number of GPUs in the backend's GPU handle list
+static std::atomic<uint32_t> g_power_num_gpu{0};
+/// serializes smi-power thread start and stop
+static std::mutex g_power_thread_mu;
+/// smi-power thread, protected by g_power_thread_mu
+static sdk::lib::thread *g_power_thread = NULL;
+/// set by the first stop, never cleared: no start after shutdown began
+static bool g_power_shutdown = false;
+/// protects g_power_view
+static std::mutex g_power_view_mu;
+/// latest power view published by the smi-watcher
+static std::shared_ptr<const gpu_watch_power_view_t> g_power_view;
+/// bumped on every power view publish
+static std::atomic<uint32_t> g_power_view_gen{0};
+
+/// \brief    CLOCK_MONOTONIC now, in ns
+static inline uint64_t
+smi_watch_mono_ns_ (void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ((uint64_t)ts.tv_sec * 1000000000ull) + (uint64_t)ts.tv_nsec;
+}
+
+/// \brief    seqlock write of one GPU's POWER tier record (smi-power only)
+/// \param[in] gpu_idx    index of the GPU in the backend's GPU handle list
+/// \param[in] fields     watch record holding the POWER tier values
+static void
+smi_watch_power_rec_write_ (uint32_t gpu_idx,
+                            const aga_gpu_watch_fields_t *fields)
+{
+    gpu_watch_power_rec_t *rec = &g_power_rec[gpu_idx];
+
+    // odd: write in progress; the release fence keeps the value stores below
+    // from becoming visible before the odd sequence
+    rec->seq.fetch_add(1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    for (uint32_t i = 0; i < k_num_power_attrs; i++) {
+        rec->val[i].store(fields->*k_power_fields[i],
+                          std::memory_order_relaxed);
+    }
+    // even: write complete, publishes the values
+    rec->seq.fetch_add(1, std::memory_order_release);
+}
+
+/// \brief    hand GPUs not read by the smi-power thread back to the
+///           smi-watcher
+/// \param[in] view    power view in effect, nullptr hands back every GPU
+static void
+smi_watch_power_disown_ (const gpu_watch_power_view_t *view)
+{
+    for (uint32_t gpu = 0; gpu < AGA_MAX_GPU; gpu++) {
+        if ((view == nullptr) || !view->gpus.test(gpu)) {
+            g_power_owned[gpu].store(false, std::memory_order_release);
+        }
+    }
+}
+
+/// \brief    park the smi-power thread: the smi-watcher owns the POWER tier
+///           again; returns after k_power_park_ns or a wake post
+static void
+smi_watch_power_park_ (void)
+{
+    int rv;
+    struct timespec ts;
+
+    g_power_active.store(false, std::memory_order_release);
+    smi_watch_power_disown_(nullptr);
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_nsec += (long)k_power_park_ns;
+    if (ts.tv_nsec >= 1000000000L) {
+        ts.tv_sec += 1;
+        ts.tv_nsec -= 1000000000L;
+    }
+    do {
+        rv = sem_timedwait(smi_watch_power_wake_(), &ts);
+    } while ((rv != 0) && (errno == EINTR));
+}
+
+/// \brief    sleep until an absolute CLOCK_MONOTONIC deadline
+/// \param[in] deadline_ns    deadline in ns
+static void
+smi_watch_power_sleep_until_ (uint64_t deadline_ns)
+{
+    int rv;
+    struct timespec ts;
+
+    ts.tv_sec = (time_t)(deadline_ns / 1000000000ull);
+    ts.tv_nsec = (long)(deadline_ns % 1000000000ull);
+    do {
+        rv = clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);
+    } while (rv == EINTR);
+}
+
+/// \brief    smi-power thread body
+/// NOTE:
+/// active only while the fast period is sub-second and the power view has a
+/// watch, parked otherwise. one pass per tick on absolute deadlines, one SMI
+/// call in flight; overrun ticks are counted and skipped, never caught up.
+/// no allocation per tick
+static void *
+smi_watch_power_thread_run_ (void *ctxt)
+{
+    uint64_t k;
+    uint32_t gpu;
+    uint32_t pos;
+    uint64_t missed;
+    uint64_t now_ns;
+    uint64_t seq = 0;
+    uint32_t fast_ms;
+    uint32_t num_gpu;
+    uint64_t next_ns = 0;
+    uint32_t view_gen = 0;
+    uint64_t period_ns = 0;
+    uint64_t last_warn_ns = 0;
+    aga_gpu_watch_fields_t fields;
+    std::shared_ptr<const gpu_watch_power_view_t> view;
+
+    num_gpu = g_power_num_gpu.load(std::memory_order_acquire);
+    while (!g_power_stop.load(std::memory_order_acquire)) {
+        // pick up a newly published power view (rare)
+        if (g_power_view_gen.load(std::memory_order_acquire) != view_gen) {
+            std::lock_guard<std::mutex> lock(g_power_view_mu);
+
+            view = g_power_view;
+            view_gen = g_power_view_gen.load(std::memory_order_relaxed);
+            // GPUs that left the view are read by the smi-watcher again
+            smi_watch_power_disown_(view.get());
+        }
+        fast_ms = smi_watch_fast_period_ms();
+        if ((fast_ms >= AGA_GPU_WATCH_FAST_TIER_MIN_MS) || !view ||
+            view->watches.empty()) {
+            // parking resets the deadline, so idle time and period switches
+            // are never counted as missed
+            next_ns = 0;
+            smi_watch_power_park_();
+            continue;
+        }
+        if ((next_ns == 0) || (period_ns != (uint64_t)fast_ms * 1000000ull)) {
+            period_ns = (uint64_t)fast_ms * 1000000ull;
+            next_ns = smi_watch_mono_ns_();
+        }
+        seq++;
+        missed = g_missed_ticks.load(std::memory_order_relaxed);
+        // one read per needed GPU; a failed read leaves the POWER tier NA
+        // for this tick, never 0 and never stale
+        for (gpu = 0; gpu < num_gpu; gpu++) {
+            if (!view->gpus.test(gpu)) {
+                continue;
+            }
+            aga_gpu_watch_reset_power_fields(&fields);
+            smi_watch_power_read(gpu, &fields);
+            smi_watch_power_rec_write_(gpu, &fields);
+            g_power_owned[gpu].store(true, std::memory_order_release);
+            // publish this GPU right after its read, not after the pass
+            for (const auto& watch : view->watches) {
+                for (pos = 0; pos < watch.num_gpu; pos++) {
+                    if (watch.gpu_idx[pos] == gpu) {
+                        break;
+                    }
+                }
+                if (pos == watch.num_gpu) {
+                    continue;
+                }
+                for (const auto& q : watch.queues) {
+                    smi_watch_sub_queue_push_power(q.get(), &watch, pos, seq,
+                                                   missed);
+                }
+            }
+        }
+        g_power_active.store(true, std::memory_order_release);
+        // absolute deadlines: tick k starts at t0 + k * period whatever the
+        // previous tick took; deadlines already passed are skipped
+        next_ns += period_ns;
+        now_ns = smi_watch_mono_ns_();
+        if (now_ns >= next_ns) {
+            k = ((now_ns - next_ns) / period_ns) + 1;
+            g_missed_ticks.fetch_add(k, std::memory_order_relaxed);
+            next_ns += k * period_ns;
+            if ((last_warn_ns == 0) ||
+                ((now_ns - last_warn_ns) >= k_power_warn_ns)) {
+                last_warn_ns = now_ns;
+                AGA_TRACE_WARN("smi-power overran {} ms period, {} power "
+                               "ticks missed in total", fast_ms,
+                               g_missed_ticks.load(std::memory_order_relaxed));
+            }
+        }
+        smi_watch_power_sleep_until_(next_ns);
+    }
+    g_power_active.store(false, std::memory_order_release);
+    smi_watch_power_disown_(nullptr);
+    return NULL;
+}
+
+sdk_ret_t
+smi_watch_power_thread_start (uint32_t num_gpu)
+{
+    sdk_ret_t ret;
+    std::lock_guard<std::mutex> lock(g_power_thread_mu);
+
+    if (g_power_shutdown) {
+        return SDK_RET_ERR;
+    }
+    if (g_power_thread != NULL) {
+        return SDK_RET_OK;
+    }
+    g_power_num_gpu.store((num_gpu < AGA_MAX_GPU) ? num_gpu : AGA_MAX_GPU,
+                          std::memory_order_release);
+    g_power_stop.store(false, std::memory_order_release);
+    g_power_thread =
+        sdk::lib::thread::factory("smi-power", AGA_THREAD_ID_WATCHER_POWER,
+            sdk::lib::THREAD_ROLE_CONTROL, 0x0, smi_watch_power_thread_run_,
+            sdk::lib::thread::priority_by_role(sdk::lib::THREAD_ROLE_CONTROL),
+            sdk::lib::thread::sched_policy_by_role(
+                sdk::lib::THREAD_ROLE_CONTROL));
+    if (g_power_thread == NULL) {
+        g_power_failed.store(true, std::memory_order_release);
+        AGA_TRACE_ERR("smi-power thread create failure, POWER tier stays "
+                      "with smi-watcher, sub-second periods not supported");
+        return SDK_RET_ERR;
+    }
+    ret = g_power_thread->start(NULL);
+    if (ret != SDK_RET_OK) {
+        // start() can fail after pthread_create succeeded; never leave that
+        // thread running unjoined across the SMI library shutdown
+        if (g_power_thread->pthread_id() != 0) {
+            g_power_stop.store(true, std::memory_order_release);
+            sem_post(smi_watch_power_wake_());
+            g_power_thread->wait_until_complete();
+            g_power_thread->set_running(false);
+        }
+        sdk::lib::thread::destroy(g_power_thread);
+        g_power_thread = NULL;
+        g_power_failed.store(true, std::memory_order_release);
+        AGA_TRACE_ERR("smi-power thread start failure, err {}, POWER tier "
+                      "stays with smi-watcher, sub-second periods not "
+                      "supported", ret());
+        return ret;
+    }
+    AGA_TRACE_INFO("smi-power thread started, {} GPUs", num_gpu);
+    return SDK_RET_OK;
+}
+
+void
+smi_watch_power_thread_stop (void)
+{
+    std::lock_guard<std::mutex> lock(g_power_thread_mu);
+
+    g_power_shutdown = true;
+    if (g_power_thread == NULL) {
+        return;
+    }
+    // ask the thread to exit and join it; no pthread_cancel, so it never
+    // dies inside an SMI call
+    g_power_stop.store(true, std::memory_order_release);
+    sem_post(smi_watch_power_wake_());
+    g_power_thread->wait_until_complete();
+    g_power_thread->set_running(false);
+    sdk::lib::thread::destroy(g_power_thread);
+    g_power_thread = NULL;
+    AGA_TRACE_INFO("smi-power thread stopped");
+}
+
+bool
+smi_watch_power_thread_failed (void)
+{
+    return g_power_failed.load(std::memory_order_acquire);
+}
+
+bool
+smi_watch_power_active (void)
+{
+    return g_power_active.load(std::memory_order_acquire);
+}
+
+bool
+smi_watch_power_snapshot (uint32_t gpu_idx, aga_gpu_watch_fields_t *out)
+{
+    uint32_t seq0;
+    uint32_t seq1;
+    uint32_t tries;
+    gpu_watch_power_rec_t *rec;
+    uint64_t val[AGA_GPU_WATCH_POWER_ATTRS_MAX];
+
+    if ((gpu_idx >= AGA_MAX_GPU) ||
+        !g_power_owned[gpu_idx].load(std::memory_order_acquire)) {
+        return false;
+    }
+    rec = &g_power_rec[gpu_idx];
+    for (tries = 1; ; tries++) {
+        seq0 = rec->seq.load(std::memory_order_acquire);
+        for (uint32_t i = 0; i < k_num_power_attrs; i++) {
+            val[i] = rec->val[i].load(std::memory_order_relaxed);
+        }
+        std::atomic_thread_fence(std::memory_order_acquire);
+        seq1 = rec->seq.load(std::memory_order_relaxed);
+        if (((seq0 & 1) == 0) && (seq0 == seq1)) {
+            break;
+        }
+        if (tries >= k_power_snapshot_tries) {
+            // the writer never waits; use this copy, the next fast period
+            // refreshes it
+            AGA_TRACE_VERBOSE("GPU {} power record busy after {} tries, "
+                              "using a possibly mixed copy", gpu_idx, tries);
+            break;
+        }
+        // a write still in progress after a few tries means the writer was
+        // preempted mid-write; let it run instead of spinning
+        if (tries >= k_power_snapshot_spins) {
+            sched_yield();
+        }
+    }
+    for (uint32_t i = 0; i < k_num_power_attrs; i++) {
+        out->*k_power_fields[i] = val[i];
+    }
+    return true;
+}
+
+void
+smi_watch_power_view_set (std::shared_ptr<const gpu_watch_power_view_t> view)
+{
+    {
+        std::lock_guard<std::mutex> lock(g_power_view_mu);
+
+        g_power_view = view;
+        g_power_view_gen.fetch_add(1, std::memory_order_release);
+    }
+    sem_post(smi_watch_power_wake_());
+}
+
+uint64_t
+smi_watch_missed_ticks (void)
+{
+    return g_missed_ticks.load(std::memory_order_relaxed);
+}
+
+//----------------------------------------------------------------------------
+// per subscriber bounded frame queue
+//----------------------------------------------------------------------------
+
+/// \brief    record index of a POWER tier attr in k_power_attrs[]
+/// \param[in] id    POWER tier attr id
+/// \return   index into k_power_attrs[] (and g_power_rec[].val[])
+static inline uint32_t
+smi_watch_power_attr_idx_ (aga_gpu_watch_attr_id_t id)
+{
+    uint32_t i;
+
+    for (i = 0; i < k_num_power_attrs; i++) {
+        if (k_power_attrs[i] == id) {
+            break;
+        }
+    }
+    return i;
+}
+
+/// \brief    slot of a ring position
+/// \param[in] q      subscriber frame queue
+/// \param[in] pos    head or tail position
+/// \return   the power frame in that slot
+static inline aga_gpu_watch_power_frame_t *
+smi_watch_sub_slot_ (gpu_watch_sub_queue_t *q, uint32_t pos)
+{
+    size_t off = (size_t)(pos % q->depth) * q->slot_size;
+
+    return (aga_gpu_watch_power_frame_t *)(q->slots + off);
+}
+
+/// \brief    drop the POWER tier attrs from a full frame's stats
+/// \param[in,out] info    full frame
+static void
+smi_watch_info_strip_power_ (aga_gpu_watch_info_t *info)
+{
+    uint32_t n;
+    aga_gpu_watch_attrs_t *attrs;
+
+    for (uint32_t g = 0; g < info->stats.num_gpu; g++) {
+        attrs = &info->stats.gpu_watch_attr[g];
+        n = 0;
+        for (uint32_t i = 0; i < attrs->num_attrs; i++) {
+            if (smi_watch_attr_tier(attrs->attr[i].id) ==
+                    GPU_WATCH_TIER_POWER) {
+                continue;
+            }
+            if (n != i) {
+                attrs->attr[n] = attrs->attr[i];
+            }
+            n++;
+        }
+        attrs->num_attrs = n;
+    }
+}
+
+std::shared_ptr<gpu_watch_sub_queue_t>
+smi_watch_sub_queue_alloc (uint32_t max_gpu)
+{
+    uint32_t depth;
+    uint32_t slot_size;
+    uint32_t passes = 1;
+    std::shared_ptr<gpu_watch_sub_queue_t> q;
+
+    if (max_gpu > AGA_MAX_GPU) {
+        max_gpu = AGA_MAX_GPU;
+    }
+    // a frame holds one GPU and a pass makes up to max_gpu of them, so the
+    // ring keeps AGA_GPU_WATCH_SUB_QUEUE_DEPTH passes; a power of two, so
+    // pos % depth stays continuous when head and tail wrap
+    while (passes < max_gpu) {
+        passes <<= 1;
+    }
+    depth = AGA_GPU_WATCH_SUB_QUEUE_DEPTH * passes;
+    // keep every slot 8 byte aligned
+    slot_size = sizeof(aga_gpu_watch_power_frame_t) +
+                    sizeof(aga_gpu_watch_power_gpu_t);
+    slot_size = (slot_size + 7) & ~7u;
+    try {
+        q = std::make_shared<gpu_watch_sub_queue_t>();
+        q->slots = new uint8_t[(size_t)slot_size * depth];
+    } catch (const std::bad_alloc&) {
+        return nullptr;
+    }
+    q->max_gpu = max_gpu;
+    q->depth = depth;
+    q->slot_size = slot_size;
+    return q;
+}
+
+sdk_ret_t
+smi_watch_sub_attach (aga_gpu_watch_client_ctxt_t *ctxt, uint32_t max_gpu)
+{
+    if (ctxt->queue) {
+        return SDK_RET_OK;
+    }
+    ctxt->queue = smi_watch_sub_queue_alloc(max_gpu);
+    if (!ctxt->queue) {
+        AGA_TRACE_ERR("GPU watch subscriber queue allocation failure, "
+                      "rejecting subscribe of client {}",
+                      ctxt->client.c_str());
+        return SDK_RET_OOM;
+    }
+    return SDK_RET_OK;
+}
+
+bool
+smi_watch_sub_queue_push_power (gpu_watch_sub_queue_t *q,
+                                const gpu_watch_power_view_t::watch_t *watch,
+                                uint32_t pos, uint64_t seq,
+                                uint64_t missed_ticks)
+{
+    uint32_t idx;
+    uint32_t head;
+    uint32_t tail;
+    uint32_t rec_idx;
+    aga_gpu_watch_power_gpu_t *gpu;
+    aga_gpu_watch_power_frame_t *frame;
+
+    head = q->head.load(std::memory_order_relaxed);
+    tail = q->tail.load(std::memory_order_acquire);
+    if ((head - tail) >= q->depth) {
+        // drop the newest frame, never wait for the subscriber; MissedTicks
+        // counts ticks, so a tick's dropped GPU frames count once
+        if (q->drop_seq != seq) {
+            q->drop_seq = seq;
+            q->dropped.fetch_add(1, std::memory_order_relaxed);
+        }
+        return false;
+    }
+    idx = watch->gpu_idx[pos];
+    frame = smi_watch_sub_slot_(q, head);
+    frame->watch_key = watch->key;
+    frame->seq = seq;
+    frame->missed_ticks = missed_ticks;
+    frame->num_gpu = 1;
+    frame->num_attrs = watch->num_attrs;
+    gpu = &frame->gpu[0];
+    gpu->gpu_idx = idx;
+    gpu->gpu = watch->gpu_key[pos];
+    // the producer's own record values, no seqlock read needed
+    for (uint32_t a = 0; a < watch->num_attrs; a++) {
+        frame->attr_id[a] = watch->attr_id[a];
+        rec_idx = smi_watch_power_attr_idx_(watch->attr_id[a]);
+        gpu->val[a] = (rec_idx < k_num_power_attrs) ?
+            g_power_rec[idx].val[rec_idx].load(std::memory_order_relaxed) :
+            UINT64_MAX;
+    }
+    // publish the slot to the subscriber's gRPC thread
+    q->head.store(head + 1, std::memory_order_release);
+    sem_post(&q->wake);
+    return true;
+}
+
+void
+smi_watch_sub_queue_push_full (gpu_watch_sub_queue_t *q,
+                               std::shared_ptr<const aga_gpu_watch_info_t> info)
+{
+    bool replaced = false;
+
+    {
+        std::lock_guard<std::mutex> lock(q->full_mu);
+
+        for (auto& pending : q->full) {
+            if (pending->spec.key == info->spec.key) {
+                // the subscriber has not written the previous one yet
+                pending = info;
+                replaced = true;
+                q->dropped.fetch_add(1, std::memory_order_relaxed);
+                break;
+            }
+        }
+        if (!replaced) {
+            q->full.push_back(info);
+        }
+    }
+    sem_post(&q->wake);
+}
+
+void
+smi_watch_notify_full (gpu_watch_subscriber_db_t *db, bool skip_power)
+{
+    aga_obj_key_t key;
+    std::shared_ptr<aga_gpu_watch_info_t> info;
+
+    for (auto& it : db->gpu_watch_map) {
+        if (it.second.client_set.empty()) {
+            continue;
+        }
+        key = it.first;
+        AGA_TRACE_VERBOSE("GPU watch {} notify subscribers", key.str());
+        // heap-allocated: aga_gpu_watch_info_t is large; read once per watch
+        // and shared by all its subscribers until each one has written it
+        try {
+            info = std::make_shared<aga_gpu_watch_info_t>();
+        } catch (const std::bad_alloc&) {
+            AGA_TRACE_ERR("GPU watch {} frame allocation failure", key.str());
+            continue;
+        }
+        // a frame without the spec would look partial, so send nothing
+        if (aga_gpu_watch_read(&key, info.get()) != SDK_RET_OK) {
+            continue;
+        }
+        if (skip_power) {
+            // the smi-power thread is the only publisher of the POWER tier
+            smi_watch_info_strip_power_(info.get());
+        }
+        for (auto client_ctxt : it.second.client_set) {
+            if (client_ctxt->write_failed.load(std::memory_order_acquire)) {
+                continue;
+            }
+            smi_watch_sub_queue_push_full(client_ctxt->queue.get(), info);
+        }
+    }
+}
+
+void
+smi_watch_sub_reap (gpu_watch_subscriber_db_t *db,
+                    vector<gpu_watch_subscriber_info_t> *failed)
+{
+    uint64_t now_ns;
+    uint64_t dropped;
+    gpu_watch_sub_queue_t *q;
+    unordered_map<aga_gpu_watch_client_ctxt_t *, bool> failed_of;
+
+    now_ns = smi_watch_mono_ns_();
+    // read write_failed once per subscriber, so a stream on several watches
+    // is listed with all of its (watch, ctxt) pairs or none
+    for (auto& it : db->gpu_watch_map) {
+        for (auto client_ctxt : it.second.client_set) {
+            auto res = failed_of.emplace(client_ctxt, false);
+
+            if (!res.second) {
+                continue;
+            }
+            if (client_ctxt->write_failed.load(std::memory_order_acquire)) {
+                res.first->second = true;
+                continue;
+            }
+            q = client_ctxt->queue.get();
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            if ((dropped == q->dropped_logged) ||
+                ((q->drop_warn_ns != 0) &&
+                 ((now_ns - q->drop_warn_ns) < k_sub_drop_warn_ns))) {
+                continue;
+            }
+            // the count is per subscriber (stream), whatever watch it is for
+            AGA_TRACE_WARN("GPU watch client {} is slow, {} frames dropped, "
+                           "{} in total", client_ctxt->client.c_str(),
+                           dropped - q->dropped_logged, dropped);
+            q->dropped_logged = dropped;
+            q->drop_warn_ns = now_ns;
+        }
+    }
+    for (auto& it : db->gpu_watch_map) {
+        for (auto client_ctxt : it.second.client_set) {
+            if (failed_of[client_ctxt]) {
+                failed->push_back({ it.first, client_ctxt });
+            }
+        }
+    }
+}
+
+void
+smi_watch_sub_client_release (aga_gpu_watch_client_ctxt_t *ctxt)
+{
+    // keep the queue (and its semaphore) alive past the release: the gRPC
+    // thread may free ctxt as soon as client_inactive is set
+    std::shared_ptr<gpu_watch_sub_queue_t> q = ctxt->queue;
+
+    ctxt->client_inactive.store(true, std::memory_order_release);
+    if (q) {
+        sem_post(&q->wake);
+    }
+}
+
+void
+smi_watch_sub_writer_loop (aga_gpu_watch_client_ctxt_t *ctxt)
+{
+    sdk_ret_t ret;
+    uint32_t tail;
+    uint64_t dropped;
+    struct timespec ts;
+    gpu_watch_sub_queue_t *q = ctxt->queue.get();
+    vector<std::shared_ptr<const aga_gpu_watch_info_t>> full;
+
+    while (!ctxt->client_inactive.load(std::memory_order_acquire)) {
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += k_sub_wait_secs;
+        // a timeout or EINTR only re-checks client_inactive
+        sem_timedwait(&q->wake, &ts);
+        if (ctxt->write_failed.load(std::memory_order_acquire)) {
+            // wait for the smi-watcher to remove this subscriber
+            continue;
+        }
+        ret = SDK_RET_OK;
+        {
+            std::lock_guard<std::mutex> lock(q->full_mu);
+
+            full.swap(q->full);
+        }
+        // full frames first: at sub-second periods they carry no POWER tier
+        // attrs, so they never overwrite a newer power value
+        for (const auto& info : full) {
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            ret = ctxt->write_cb(info.get(), dropped, ctxt);
+            if (ret != SDK_RET_OK) {
+                break;
+            }
+        }
+        full.clear();
+        // then every queued power frame, in order
+        tail = q->tail.load(std::memory_order_relaxed);
+        while ((ret == SDK_RET_OK) &&
+               (tail != q->head.load(std::memory_order_acquire))) {
+            dropped = q->dropped.load(std::memory_order_relaxed);
+            ret = ctxt->write_power_cb(smi_watch_sub_slot_(q, tail), dropped,
+                                       ctxt);
+            tail++;
+            // hand the slot back to the smi-power thread
+            q->tail.store(tail, std::memory_order_release);
+        }
+        if (ret != SDK_RET_OK) {
+            ctxt->write_failed.store(true, std::memory_order_release);
+        }
+    }
+}
+
 }    // namespace aga
