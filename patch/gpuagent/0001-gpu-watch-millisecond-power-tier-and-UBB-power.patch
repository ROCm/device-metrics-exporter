+/// \brief    mock watcher knobs, parsed on first use
+/// \return   knobs
+static const mock_watch_knobs_t *
+mock_watch_knobs_ (void)
+{
+    static const mock_watch_knobs_t knobs = {
+        mock_watch_knob_na_mask_(),
+        mock_watch_knob_uint_("AGA_MOCK_WATCH_READ_DELAY_US",
+                              AGA_MOCK_WATCH_READ_DELAY_US_MAX),
+        mock_watch_knob_uint_("AGA_MOCK_WATCH_SWEEP_DELAY_MS",
+                              AGA_MOCK_WATCH_SWEEP_DELAY_MS_MAX),
+        (mock_watch_knob_uint_("AGA_MOCK_WATCH_TRACE_READS", 1) == 1),
+    };
+
+    return &knobs;
+}
