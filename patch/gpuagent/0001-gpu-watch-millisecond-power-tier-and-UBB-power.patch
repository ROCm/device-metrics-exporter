+gpu_watch_tier_t
+smi_watch_attr_tier (aga_gpu_watch_attr_id_t id)
+{
+    for (auto attr_id : k_power_attrs) {
+        if (attr_id == id) {
+            return GPU_WATCH_TIER_POWER;
+        }
+    }
+    for (auto attr_id : k_slow_attrs) {
+        if (attr_id == id) {
+            return GPU_WATCH_TIER_SLOW;
+        }
+    }
