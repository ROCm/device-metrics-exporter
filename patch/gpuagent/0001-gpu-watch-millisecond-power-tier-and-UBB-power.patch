+    vector<std::shared_ptr<const aga_gpu_watch_info_t>> full;
+    /// posted on every enqueue and on release
+    sem_t wake;
+    /// dropped count last logged, smi-watcher only
+    uint64_t dropped_logged;
+    /// time of the last drop warning in ns, smi-watcher only
+    uint64_t drop_warn_ns;
+
+    gpu_watch_sub_queue_s();
+    ~gpu_watch_sub_queue_s();
