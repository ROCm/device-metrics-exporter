root: index
defaults:
  numbered: False
  maxdepth: 1
subtrees:
  - caption: Installation
    entries:
      - file: installation/docker
      - file: installation/kubernetes-helm
      - file: installation/gpu-operator
      - file: installation/deb-package
      - file: installation/docker-sriov
      - file: installation/deb-package-sriov
      - file: installation/nic-debian-package
      - file: installation/singularity.md
  - caption: Release notes
    entries:
      - file: releasenotes
        title: Release notes
      - file: releasenotes-nic
        title: NIC exporter release notes
  - caption: Known issues
    entries:
    - file: knownissues
      title: Known issues
  - caption: Configuration
    entries:
      - file: configuration/configuration-settings
      - file: configuration/docker
      - file: configuration/docker-sriov
      - file: configuration/network-exporter-docker
      - file: configuration/configmap
      - file: configuration/troubleshooting 
      - file: configuration/metricslist
      - file: configuration/network-metricslist
      - file: configuration/workload-cgroup-metrics
  - caption: Integrations
    entries:
    - file: integrations/prometheus-grafana
    - file: integrations/slurm-integration  
    - file: integrations/prometheus-servicemonitor
    - file: integrations/node-health-monitoring
  - caption: Developer guide
    entries:
    - file: developerguide
      title: Building from source       
